# Backend API URL, including /api. Required for production builds.
# Omit only in development to use the local Vite proxy; /api is an explicit
# production choice only when a hosting reverse proxy has been configured.
VITE_API_BASE_URL=http://localhost:5000/api
# Local proxy target when VITE_API_BASE_URL is omitted or set to /api.
API_PROXY_TARGET=http://localhost:5000
